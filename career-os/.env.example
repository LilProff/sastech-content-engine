# ── Supabase (same project as supabase-schema-career-os.sql) ──────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx            # Project Settings -> API. Server-only, never exposed to the browser.
SUPABASE_JWT_SECRET=xxxxx                  # Project Settings -> API -> JWT Settings ("Legacy JWT secret")

# ── Login ───────────────────────────────────────────────────────
APP_USER_ID=00000000-0000-0000-0000-000000000000  # UUID of the one auth.users row you create by hand (Authentication -> Add user)
APP_PASSWORD=xxxxx                         # Your own login password for the console

# ── Assistant (free at openrouter.ai) ──────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxx

# ── Opportunities gap analysis (free 2,500 searches at serper.dev) ─
SERPER_API_KEY=xxxxx
